# RagLens local environment template
# Copy this file to `.env` (already gitignored) and fill in your key.
# Get a key at https://build.nvidia.com.

NVIDIA_API_KEY=nvapi-your-key-here

# Optional overrides — see raglens/providers/nvidia_nim.py for defaults.
# RAGLENS_JUDGE_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# RAGLENS_GEN_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
# RAGLENS_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
